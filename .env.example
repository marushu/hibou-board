# Demo: binds only to loopback. This file contains no credentials.
HIBOU_MODE=demo
PORT=3000
# For production, set these in a private runtime environment:
# HIBOU_MODE=production
# HIBOU_ORIGIN=https://board.example
# HIBOU_RP_ID=board.example
# HIBOU_DATA_DIR=runtime/private/production
# HIBOU_PRIVATE_IMPORT=private/initial-state.json
# HIBOU_SERVICES_FILE=private/services.json
# HIBOU_ENROLLMENT_TOKEN= (supply out of band; minimum 32 characters)
